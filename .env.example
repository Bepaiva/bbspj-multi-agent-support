# --- Required -------------------------------------------------------------
OPENAI_API_KEY=sk-...

# --- Offline development (no network access to OpenAI) -----------------------
# LLM_PROVIDER=fake               # scripted model from tests/fakes.py - runs the real graph/tools offline
# EMBEDDINGS_PROVIDER=hash        # deterministic local embeddings (separate Chroma collection)

# --- Models -----------------------------------------------------------------
CHAT_MODEL=gpt-4o-mini
# ROUTER_MODEL=gpt-4o-mini        # optional: a cheaper/faster model for routing
EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_BASE_URL=                # optional: Azure/OpenAI-compatible gateway

# --- RAG ------------------------------------------------------------------
INGEST_ON_STARTUP=true            # build the index on first start if it is empty
INGEST_SCRAPE_WEB=true            # also scrape the live Getnet pages (seed corpus is always loaded)
RAG_TOP_K=5
RAG_MIN_RELEVANCE=0.30

# --- Web search -------------------------------------------------------------
WEB_SEARCH_PROVIDER=duckduckgo    # duckduckgo (no key) | tavily | none
# TAVILY_API_KEY=tvly-...

# --- Human handoff ----------------------------------------------------------
# HANDOFF_WEBHOOK_URL=https://outlook.office.com/webhook/...   # Teams/Slack incoming webhook

# --- Ops ------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=true
# ADMIN_TOKEN=change-me            # protects POST /admin/ingest
# LangSmith tracing (optional - every LangGraph node, LLM call and tool call is traced)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=getnet-multi-agent-support
